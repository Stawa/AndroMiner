{
  "name": "androminer-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "^7.6.8",
    "@capacitor/device": "^7.0.5",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/share": "^7.0.4",
    "chart.js": "^4.5.1",
    "material-symbols": "^0.44.12",
    "pinia": "^2.3.1",
    "vue": "^3.5.39",
    "vue-chartjs": "^5.3.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "autoprefixer": "^10.5.3",
    "playwright-core": "^1.61.1",
    "postcss": "^8.5.19",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vue-tsc": "^2.2.12"
  }
}
