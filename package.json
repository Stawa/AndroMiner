{
  "name": "androminer-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:site": "vite --config website/vite.config.ts --host 0.0.0.0 --port 5174",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:site": "vue-tsc --noEmit && vite build --config website/vite.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview --host 0.0.0.0",
    "preview:site": "vite preview --config website/vite.config.ts --port 4173",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "test": "node --test tests/*.test.mjs server/tests/*.test.mjs",
    "test:ui": "node tests/ui-smoke.mjs",
    "lint": "eslint src website tests server api eslint.config.js",
    "i18n:check": "node tests/check-i18n.mjs",
    "docs:components": "node website/src/docs/build-component-docs.mjs && prettier --write website/src/docs/components.generated.json"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/device": "^8.0.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@tailwindcss/postcss": "^4.3.3",
    "chart.js": "^4.6.1",
    "material-symbols": "^0.45.10",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.16"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@google-cloud/firestore": "^9.4.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.2",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.3",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
