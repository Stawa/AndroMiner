# Copy to .env or pass as environment variables. All values are optional.
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/stats.sqlite
RETENTION_DAYS=90
AGGREGATE_RETENTION_DAYS=1095
MIN_GROUP_SIZE=10
MIN_CHECKIN_INTERVAL_HOURS=20
RATE_LIMIT_PER_MINUTE=30
MAX_NEW_INSTALLS_PER_HOUR=2000
# Behind a trusted reverse proxy only, e.g. cf-connecting-ip or x-real-ip:
CLIENT_IP_HEADER=
CORS_ORIGIN=*
GITHUB_REPO=Stawa/AndroMiner
# Optional, server-side only, raises the GitHub API rate limit:
GITHUB_TOKEN=
GITHUB_CACHE_SECONDS=3600
