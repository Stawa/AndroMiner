{
  "buildCommand": "npm run build:stats",
  "outputDirectory": "dist-stats",
  "rewrites": [
    { "source": "/v1/:path*", "destination": "/api" },
    { "source": "/healthz", "destination": "/api" },
    { "source": "/", "destination": "/stats.html" }
  ],
  "functions": { "api/index.mjs": { "includeFiles": "server/data/**" } },
  "crons": [{ "path": "/v1/maintenance/prune", "schedule": "17 3 * * *" }]
}
